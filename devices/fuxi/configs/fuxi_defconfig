# Kernel configuration of the fuxi image.
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# STATUS: draft. Derived from UniXNU-sheng configs/sheng_defconfig. The generic
# switches are kept; every SHENG-only switch is removed rather than renamed,
# because there is no fuxi implementation behind it yet.
#
# A flag here selects code that must already exist in the tree. Turning a flag on
# without that code produces a link error, not a feature.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# NativeUfs is off until the tree has IOKit/storage/IOBlockStorageDevice.h: this
# xnu only ships a forwarding stub to a DriverKit header that does not exist here.
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=y
# The virtio transports are storage drivers too: they include
# <IOKit/storage/IOBlockStorageDevice.h>, which this xnu does not ship. Off until
# that header question is settled; the first kernel only has to reach the console.
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
# The verified-root probe is built from a SystemOS verification record that belongs to
# the owner chain, which is off. Without the switch the kernel never references it.
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
# The owner-root chain needs a verified block transport, which the disabled storage
# drivers provided. Off for the first console-only kernel; each switch is required by
# the next one, so the whole chain goes together.
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# Privileged Access Never: ARMv8.1+ hardware sets PAN=1 on every EL0->EL1 transition;
# without this switch copyio.c compiles user_access_enable/disable as no-ops and every
# copyin/copyout from user memory takes an EL1 permission fault (images A16/A17).
CONFIG_XNU_NATIVE_PAN=y
# Boot progress needs the audited UFS/owner-root and Virtio build.
CONFIG_XNU_BOOT_PROGRESS=n

# Removed from the sheng config, each for a stated reason:
#
# bsd_init calls sheng_pmgr_run() before AMFI starts; without a PMGR service
# AMFI panics with "No PMGR?". The fuxi side is a stub that only publishes
# the service (devices/fuxi/platform-power).
CONFIG_XNU_SHENG_PMGR=y
#     No fuxi platform-power implementation exists. The kernel has no PMGR path
#     for this board, and the sheng one is keyed to the tablet's power domains.
#     TODO: port build-sheng-platform-power.py, then add CONFIG_XNU_FUXI_PMGR and
#     the matching code.
#
#   CONFIG_XNU_NATIVE_PAN=y
#     Panel backlight / power sequencing. The fuxi panel is
#     qcom,mdss_dsi_m3_38_0c_0a_dsc_cmd (from /proc/cmdline), not the sheng panel.
#     TODO: needs a fuxi panel sequence.
#
#   CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
#   CONFIG_XNU_NATIVE_ADRENO=y
#     Kept out of the first pass on purpose: bring-up order is firmware, then a
#     kernel that reaches the console, then display, then GPU. Enabling these
#     before the kernel reaches the console only hides the earlier failure.
#     TODO: re-enable once the kernel boots to console. Adreno 740 is the same part
#     as on sheng, so NativeAdreno is the most likely reusable driver on this board.

# The scratch Data volume UUID. This value must equal the UUID written into the
#   userdata manifest when build userdata runs, so pick one value and keep it.
#   sheng uses 18AB5557-DC2D-469B-8758-855E60F5B0DF. Not copied: a distinct value
#   makes an accidental cross-device mount impossible.
#   Value below is fuxi's own, chosen when the kernel step first needed it; the
#   kernel records it and compares it against the mounted scratch volume.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="5C3B8E14-2A6D-4F79-B0E3-8D41F2A7C95E"

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# native-virtio-block archive unused while the transport is off
# verified root probe archive unused while the probe is off
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
