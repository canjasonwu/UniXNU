diff --git a/osfmk/kern/ipc_kobject.c b/osfmk/kern/ipc_kobject.c
index f9a166f..c272aa7 100644
--- a/osfmk/kern/ipc_kobject.c
+++ b/osfmk/kern/ipc_kobject.c
@@ -277,8 +277,15 @@ mig_init(void)
 					 * Allocating a larger-than-needed kmsg creates hole for
 					 * inlined kmsgs (IKM_TYPE_ALL_INLINED) during copyout.
 					 * Disallow that.
+					 *
+					 * Some mig generators (Apple's, when -mach_msg2 is not
+					 * passed) leave max_reply_msg at zero. That must not stop
