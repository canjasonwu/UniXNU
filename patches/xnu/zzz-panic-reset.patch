diff --git a/osfmk/arm/model_dep.c b/osfmk/arm/model_dep.c
index 0a0e04f..530aece 100644
--- a/osfmk/arm/model_dep.c
+++ b/osfmk/arm/model_dep.c
@@ -925,6 +925,10 @@ SavePanicInfo(
 void
 paniclog_flush()
 {
+#if defined(XNU_FUXI_PANIC_RESET) && XNU_FUXI_PANIC_RESET
+	extern boolean_t fuxi_panic_active;
+	extern void fuxi_panic_reset_delayed(void);
+#endif
 	unsigned int panicbuf_length = 0;
 
 	panicbuf_length = (unsigned int)(debug_buf_ptr - gPanicBase);
@@ -950,6 +954,14 @@ paniclog_flush()
 	PESavePanicInfo((unsigned char *)gPanicBase, panicbuf_length);
 
 	PE_sync_panic_buffers();
+#if defined(XNU_FUXI_PANIC_RESET) && XNU_FUXI_PANIC_RESET
+	/* The panic text is on screen by now. Give a reader time to photograph it,
+	 * then reset through PSCI; the platform reboot call does not bring this
+	 * board back. */
+	if (fuxi_panic_active) {
+		fuxi_panic_reset_delayed();
+	}
+#endif
 }
 
