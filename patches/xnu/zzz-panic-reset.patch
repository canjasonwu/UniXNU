diff --git a/osfmk/arm/model_dep.c b/osfmk/arm/model_dep.c
index 0a0e04f..52b321d 100644
--- a/osfmk/arm/model_dep.c
+++ b/osfmk/arm/model_dep.c
@@ -925,6 +925,10 @@ SavePanicInfo(
 void
 paniclog_flush()
 {
+#if defined(XNU_FUXI_PANIC_RESET) && XNU_FUXI_PANIC_RESET
+	extern boolean_t fuxi_panic_active;
+	extern void fuxi_panic_reset_delayed(void);
+#endif
 	unsigned int panicbuf_length = 0;
 
 	panicbuf_length = (unsigned int)(debug_buf_ptr - gPanicBase);
@@ -950,6 +954,14 @@ paniclog_flush()
 	PESavePanicInfo((unsigned char *)gPanicBase, panicbuf_length);
 
 	PE_sync_panic_buffers();
+#if defined(XNU_FUXI_PANIC_RESET) && XNU_FUXI_PANIC_RESET
+	/* The panic text is on screen by now. Give a reader time to photograph it,
+	 * then reset through PSCI; the platform reboot path does not bring this
+	 * board back. */
+	if (fuxi_panic_active) {
+		fuxi_panic_reset_delayed();
+	}
+#endif
 }
 
 /*
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index e9daeed..3fbfed7 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -58,6 +58,11 @@
 #include <mach_kdp.h>
 #include <kdp/kdp.h>
 #include <kdp/kdp_core.h>
+#if defined(XNU_FUXI_PANIC_RESET) && XNU_FUXI_PANIC_RESET
+	/* Set while a panic is in progress; paniclog_flush() uses it to reset the
+	 * board, which otherwise stays dead to USB until someone holds power. */
+	boolean_t fuxi_panic_active = FALSE;
+#endif
 #include <kdp/kdp_internal.h>
 #include <kdp/kdp_callout.h>
 #include <kern/cpu_number.h>
@@ -1133,6 +1138,11 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
     uint64_t panic_options_mask, void *panic_data_ptr, unsigned long panic_caller)
 {
 #pragma clang diagnostic pop
+#if defined(XNU_FUXI_PANIC_RESET) && XNU_FUXI_PANIC_RESET
+	/* Arm before anything prints: the panic text goes out through
+	 * ml_panic_trap_to_debugger() below, and its flush is where the reset fires. */
+	fuxi_panic_active = TRUE;
+#endif
 
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
 	read_lbr();
